{
  "name": "ils-backend",
  "version": "1.0.0",
  "description": "Interactive Live Streaming Backend",
  "main": "server.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsx --env-file=.env.local --watch server.ts",
    "dev:full": "./start-dev.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "seed": "tsx seed-data.js",
    "worker": "tsx --env-file=.env.local src/workers/vodWorker.ts",
    "test:ai-stream": "tsx --env-file=.env.local src/services/AI/test-ai-stream.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.989.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.989.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.10.0",
    "amqplib": "^1.0.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.2.1",
    "fix-webm-duration": "^1.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.12.0",
    "mongoose": "^7.8.10",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "prom-client": "^14.2.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "uuid": "^14.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.16.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  }
}
